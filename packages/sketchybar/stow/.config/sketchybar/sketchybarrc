#!/usr/bin/env bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

sketchybar --bar \
  position=top \
  height=32 \
  display=main \
  hidden=on \
  topmost=off \
  sticky=on \
  blur_radius=0 \
  color=0xff111318 \
  shadow=off

default=(
  padding_left=5
  padding_right=5
  icon.font="Hack Nerd Font:Bold:17.0"
  label.font="Hack Nerd Font:Bold:14.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
  popup.background.color=0xee111318
  popup.background.corner_radius=8
  popup.blur_radius=20
)
sketchybar --default "${default[@]}"

sketchybar --add event wm_workspace_change

sketchybar --add item front_app left \
  --set front_app \
  icon.drawing=off \
  label.width=140 \
  label.max_chars=26 \
  label.align=left \
  script="$PLUGIN_DIR/front_app.sh" \
  click_script="$PLUGIN_DIR/action_click.sh front_app" \
  --subscribe front_app front_app_switched

# These are dormant bootstrap definitions. Hammerspoon's
# sketchybar.rightItemOrder enables and orders only the configured items.
sketchybar --add item input_source right \
  --set input_source \
  drawing=off updates=off \
  icon="󰌌" \
  label="--" \
  click_script="$PLUGIN_DIR/action_click.sh input_source" \
  --add item clock right \
  --set clock \
  drawing=off updates=off \
  update_freq=10 \
  icon= \
  script="$PLUGIN_DIR/clock.sh" \
  click_script="$PLUGIN_DIR/action_click.sh clock" \
  --add item volume right \
  --set volume \
  drawing=off updates=off \
  script="$PLUGIN_DIR/volume.sh" \
  click_script="$PLUGIN_DIR/action_click.sh volume" \
  --subscribe volume volume_change \
  --add item battery right \
  --set battery \
  drawing=off updates=off \
  update_freq=120 \
  script="$PLUGIN_DIR/battery.sh" \
  click_script="$PLUGIN_DIR/action_click.sh battery" \
  --subscribe battery system_woke power_source_change \
  --add item key_lights right \
  --set key_lights \
  drawing=off updates=off \
  icon="󰛨" \
  label="…" \
  click_script="$PLUGIN_DIR/action_click.sh key_lights" \
  --add item caffeine right \
  --set caffeine \
  drawing=off updates=off \
  icon=" " \
  icon.width=21 \
  icon.align=center \
  icon.background.drawing=on \
  icon.background.image="$HOME/.hammerspoon/modules/caffeine/assets/coffee.empty.16.png" \
  icon.background.image.drawing=on \
  icon.background.image.scale=1.0 \
  label="Off" \
  click_script="$PLUGIN_DIR/action_click.sh caffeine" \
  --add item plex right \
  --set plex \
  drawing=off updates=off \
  icon="󰚺" \
  label="Off" \
  click_script="$PLUGIN_DIR/action_click.sh plex" \
  --add item codex right \
  --set codex \
  drawing=off updates=off \
  icon="󰚩" \
  update_freq=30 \
  script="$PLUGIN_DIR/codex_usage.sh" \
  click_script="$PLUGIN_DIR/action_click.sh codex"

sketchybar --add item wm_observer left \
  --set wm_observer drawing=off script="$PLUGIN_DIR/workspace_sync.sh" \
  --subscribe wm_observer wm_workspace_change

sketchybar --update
"$PLUGIN_DIR/request_refresh.sh"
